NODE_ENV=development
PORT=3000

# Auth.js cookie and token signing secret: use at least 32 random characters.
AUTH_SECRET=

# Optional Google sign-in (both values must be present to enable the button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon pooled runtime URL and direct migration URL.
NEON_DATABASE_URL=
NEON_DIRECT_URL=

# Server-side OTP email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional private document storage. These values stay on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_BUCKET=

# Web Push (generate one VAPID key pair and keep the private key server-side).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hemiplaperceeinformation@gmail.com
